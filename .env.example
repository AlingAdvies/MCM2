# dotenv print anders willekeurige "tip"-regels (soms met externe URL's) naar de console bij elke .config()-aanroep.
DOTENV_CONFIG_QUIET=true

# Database (Supabase Session Pooler). Gebruik de runtime-rol (clm_api_runtime),
# nooit de postgres-beheerrol — die heeft BYPASSRLS en omzeilt tenant-isolatie.
# Zie docs/STATUS.md (P0) en docs/adr/ADR-008-clm-admin-rechten.md.
DATABASE_URL="postgresql://clm_api_runtime.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?schema=public"

# Uitsluitend voor `npm run migrate:deploy` en `npm run db:generate` — nooit door de
# applicatie zelf gebruikt. clm_migrator is eigenaar van clm/ref/audit en
# voert schemawijzigingen uit; de runtime (DATABASE_URL hierboven) gebruikt
# een losse, beperktere rol. Zie ADR-009.
MIGRATION_DATABASE_URL="postgresql://clm_migrator.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?schema=public"

# Backupdump — een rol die ALLE rijen ziet.
#
# Sinds FORCE ROW LEVEL SECURITY (migratie 0011) kan clm_migrator de database
# niet meer dumpen: pg_dump leest zonder tenantcontext en krijgt
# "query would be affected by row-level security policy". FORCE geldt namelijk
# ook voor de tabeleigenaar — dat is precies de bedoeling ervan.
#
# Alleen een rol met BYPASSRLS kan dumpen; bij Supabase is dat postgres.
# Bewust een EIGEN variabele: de keuze voor een ruimere rol hoort zichtbaar te
# zijn, niet verstopt in een script. Dat de backup een BYPASSRLS-rol gebruikt
# terwijl de applicatie dat nooit mag (ADR-008) is een spanningsveld dat een
# expliciet besluit verdient — zie Issue #78.
#
# Leeg laten op omgevingen zonder FORCE RLS (verse containers, CI): dan valt
# backup-dump.js terug op MIGRATION_DATABASE_URL.
BACKUP_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# API
PORT=5001

# ── Identity: OIDC / Entra External ID (Issue #7, spoor 1) ───────────────────
#
# De backend leidt de tenant af uit een geverifieerd ID-token, nooit uit een
# header of query-parameter (MCM2-CLAUDE.md §6).
#
# De waarden hieronder horen bij de Entra External ID-tenant `mcm2ciam`; de
# volledige configuratie staat in
# docs/architecture-review/2026-07-27/01-entra-external-id-poc-bevindingen.md.
#
# Bewust OIDC_* en niet ENTRA_*: ADR-006 vraagt een generieke identity-laag.
# Een verhuizing naar een Bizaline-tenant blijft daarmee een
# configuratiewijziging, geen codewijziging.
#
# Vervang 17b5535b-0a0b-4025-b381-b50b462496bc door de tenant-ID van de external tenant. Ontbreekt één
# van deze waarden, dan faalt /auth/login hard met een melding die precies
# noemt wat er mist — de rest van de backend blijft werken. Bewust zo: de
# e2e-tests en de leverancierskant draaien zonder identity-configuratie.
# LET OP — de issuer wijkt af van de andere endpoints: hier staat het
# TENANT-ID vóór .ciamlogin.com, niet de tenantnaam. Dat is geen typefout maar
# wat Entra werkelijk in de `iss`-claim zet, gemeten op 2026-07-31 via
# .well-known/openid-configuration.
#
# De verificatie vergelijkt deze waarde exact. Met de voor de hand liggende
# variant (mcm2ciam.ciamlogin.com) faalt élke login, met een melding die niet
# verklapt dat het om de issuer gaat.
OIDC_ISSUER="https://17b5535b-0a0b-4025-b381-b50b462496bc.ciamlogin.com/17b5535b-0a0b-4025-b381-b50b462496bc/v2.0"
OIDC_TOKEN_ENDPOINT="https://mcm2ciam.ciamlogin.com/17b5535b-0a0b-4025-b381-b50b462496bc/oauth2/v2.0/token"
OIDC_JWKS_URI="https://mcm2ciam.ciamlogin.com/17b5535b-0a0b-4025-b381-b50b462496bc/discovery/v2.0/keys"

# De app-registratie van de BACKEND (niet die van de federatie-trust).
OIDC_CLIENT_ID="12020e2b-93f1-4401-ae05-4937d5338dee"

# NOOIT committen. Waarde uit de "Value"-kolom van het client secret, niet de
# "Secret ID" — die verwisseling kostte tijdens de PoC al een keer een middag.
OIDC_CLIENT_SECRET="<client-secret>"

# Moet exact overeenkomen met een redirect-URI in de app-registratie.
OIDC_REDIRECT_URI="http://localhost:5001/auth/callback"

# Speling op exp/nbf in seconden, voor klokverschil. Standaard 30, maximaal 300.
# Elke seconde speling is een seconde waarin een verlopen token nog geldt.
# OIDC_CLOCK_TOLERANCE_SECONDS=30

# Alleen nodig wanneer de provider de authorize-endpoint niet naast de
# token-endpoint zet. Standaard wordt hij daaruit afgeleid (/token → /authorize).
# OIDC_AUTHORIZATION_ENDPOINT="https://.../oauth2/v2.0/authorize"

# ── Sessies (Issue #7, spoor 1) ──────────────────────────────────────────────
#
# Het sessiecookie is standaard Secure en draagt de __Host--prefix. Lokaal
# ontwikkelen gaat over http, en dan weigert de browser zo'n cookie. Alleen
# daarvoor bestaat deze schakelaar.
#
# NOOIT op 'true' buiten je eigen machine: een sessiecookie zonder Secure gaat
# onversleuteld over de lijn. Alleen exact 'true' telt; elke andere waarde
# (ook 'True' of '1') laat Secure aan staan.
# SESSIE_COOKIE_INSECURE=true

# Waar de gebruiker heen gaat na in- en uitloggen. Standaard '/'.
# NA_LOGIN_URL="http://localhost:3000/"
# NA_LOGOUT_URL="http://localhost:3000/"

# Herkomst(en) van de frontend, komma-gescheiden. Nodig zodra de frontend op
# een andere herkomst draait dan de backend: pas met deze waarde stuurt de
# browser het sessiecookie mee. Zonder deze variabele blijft CORS open zonder
# credentials — dat werkt voor de leverancierskant, niet voor ingelogde
# gebruikers.
# CORS_ORIGIN="http://localhost:3000"

# Object storage (lokaal: MinIO, later: AWS S3 — zelfde env-var-namen)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mcm2-documents

# Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Feature flags
FEATURE_VENDORS_ENABLED=false

# Telegram-melding voor de backupcontrole (scripts/backup-controle.js).
#
# Besluit eigenaar 2026-08-04: hergebruik de bestaande bot van de Saxo-app
# (waarden staan in ~/saxo/.env op de server). Geen aparte MCM2-bot, want dit
# gaat uiteindelijk naar Slack — dan is een tweede Telegram-bot weggegooide
# moeite. Gevolg: MCM2-meldingen komen in hetzelfde gesprek als de Saxo-app.
#
# Leeg laten = geen melding, script draait wel door (bruikbaar in CI).
# Inrichting: docs/runbooks/backupcontrole.md stap 1.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

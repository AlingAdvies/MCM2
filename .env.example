# dotenv print anders willekeurige "tip"-regels (soms met externe URL's) naar de console bij elke .config()-aanroep.
DOTENV_CONFIG_QUIET=true

# Database (Supabase Session Pooler). Gebruik de runtime-rol (clm_api_runtime),
# nooit de postgres-beheerrol — die heeft BYPASSRLS en omzeilt tenant-isolatie.
# Zie docs/STATUS.md (P0) en docs/adr/ADR-008-clm-admin-rechten.md.
DATABASE_URL="postgresql://clm_api_runtime.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?schema=public"

# Uitsluitend voor `npm run migrate:deploy` en `npm run db:generate` — nooit door de
# applicatie zelf gebruikt. clm_migrator is eigenaar van clm/ref/audit en
# voert schemawijzigingen uit; de runtime (DATABASE_URL hierboven) gebruikt
# een losse, beperktere rol. Zie ADR-009.
MIGRATION_DATABASE_URL="postgresql://clm_migrator.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?schema=public"

# API
PORT=5001

# ── Identity: OIDC / Entra External ID (Issue #7, spoor 1) ───────────────────
#
# De backend leidt de tenant af uit een geverifieerd ID-token, nooit uit een
# header of query-parameter (MCM2-CLAUDE.md §6).
#
# De waarden hieronder horen bij de Entra External ID-tenant `mcm2ciam`; de
# volledige configuratie staat in
# docs/architecture-review/2026-07-27/01-entra-external-id-poc-bevindingen.md.
#
# Bewust OIDC_* en niet ENTRA_*: ADR-006 vraagt een generieke identity-laag.
# Een verhuizing naar een Bizaline-tenant blijft daarmee een
# configuratiewijziging, geen codewijziging.
#
# Vervang <tenant-id> door de tenant-ID van de external tenant. De backend
# weigert op te starten zodra één van deze waarden ontbreekt — dat is opzet:
# anders faalt het pas bij de eerste inlogpoging.
OIDC_ISSUER="https://mcm2ciam.ciamlogin.com/<tenant-id>/v2.0"
OIDC_TOKEN_ENDPOINT="https://mcm2ciam.ciamlogin.com/<tenant-id>/oauth2/v2.0/token"
OIDC_JWKS_URI="https://mcm2ciam.ciamlogin.com/<tenant-id>/discovery/v2.0/keys"

# De app-registratie van de BACKEND (niet die van de federatie-trust).
OIDC_CLIENT_ID="<client-id-van-de-backend-app-registratie>"

# NOOIT committen. Waarde uit de "Value"-kolom van het client secret, niet de
# "Secret ID" — die verwisseling kostte tijdens de PoC al een keer een middag.
OIDC_CLIENT_SECRET="<client-secret>"

# Moet exact overeenkomen met een redirect-URI in de app-registratie.
OIDC_REDIRECT_URI="http://localhost:5001/auth/callback"

# Speling op exp/nbf in seconden, voor klokverschil. Standaard 30, maximaal 300.
# Elke seconde speling is een seconde waarin een verlopen token nog geldt.
# OIDC_CLOCK_TOLERANCE_SECONDS=30

# Object storage (lokaal: MinIO, later: AWS S3 — zelfde env-var-namen)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mcm2-documents

# Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Feature flags
FEATURE_VENDORS_ENABLED=false
